# Python bytecode and build artifacts
__pycache__/
*.py[cod]
*$py.class
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Local environment configuration (keep the safe template)
.env
.env.*
!.env.example

# Test, coverage, lint, and type-checking caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.tox/
.nox/

# IDE and notebook files
.idea/
.vscode/
*.swp
*.swo
.ipynb_checkpoints/

# Operating system files
.DS_Store
Thumbs.db

# Local datasets and generated data; preserve directory placeholders
data/*
!data/raw/
!data/processed/
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
